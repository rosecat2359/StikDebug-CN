        }
      }
    },
    "StikDebug isn't meant to attach to itself. Enabling JIT for StikDebug serves no purpose. Select the app you want to enable JIT for instead.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "StikDebug 不适合附加到自身。为 StikDebug 启用 JIT 没有任何作用。请改为选择你想要启用 JIT 的应用。"
          }
        }
      }
    },
    "StikDebug isn't meant to enable JIT for LiveContainer manually. Select StikDebug in LiveContainer settings, enable \"Run with JIT\" for your app, then open your app normally. It will automatically jump back here.": {
      "extractionState": "manual",
      "localizations": {
